{
  "name": "pandan-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/set-env.js && ng build",
    "config:env": "node scripts/set-env.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@types/three": "^0.185.4",
    "rxjs": "~7.8.2",
    "three": "^0.185.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@playwright/test": "^1.62.1",
    "@types/google.maps": "^3.65.5",
    "@types/jasmine": "~6.0.0",
    "@types/jest": "^30.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "jest": "^30.4.2",
    "jest-preset-angular": "^17.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "@angular/common": "$@angular/common",
    "@angular/core": "$@angular/core",
    "@angular/cdk": "$@angular/cdk",
    "@angular/forms": "$@angular/forms",
    "@angular/material": "$@angular/material",
    "@angular/platform-browser": "$@angular/platform-browser",
    "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
    "@angular/router": "$@angular/router",
    "@angular/compiler": "$@angular/compiler"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "unrs-resolver": true
  }
}