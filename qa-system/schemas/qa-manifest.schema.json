{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Angular AI QA & Living Manual Manifest",
  "description": "Single source of truth mapping Angular services, components, routes, quality dimensions, and User Manual chapters.",
  "type": "object",
  "required": ["version", "lastVerifiedCommit", "projectConfig", "services", "components", "featureSlices"],
  "properties": {
    "version": { "type": "string", "default": "1.0.0" },
    "lastVerifiedCommit": { "type": "string" },
    "projectConfig": {
      "type": "object",
      "required": ["angularRoot", "openApiSchemaPath", "supportedLocales", "roles", "viewports"],
      "properties": {
        "angularRoot": { "type": "string", "default": "src/app" },
        "openApiSchemaPath": { "type": "string", "default": "openapi.json" },
        "supportedLocales": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["en-US"]
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["admin", "user", "guest"]
        },
        "viewports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "integer" },
              "height": { "type": "integer" }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["filePath", "specPath", "specStatus", "httpEndpoints", "dependents"],
        "properties": {
          "filePath": { "type": "string" },
          "specPath": { "type": "string" },
          "specStatus": {
            "type": "string",
            "enum": ["MISSING", "SHALLOW_STUB", "TRIAGED", "VERIFIED"]
          },
          "publicMethods": { "type": "array", "items": { "type": "string" } },
          "httpEndpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": { "type": "string" },
                "urlPattern": { "type": "string" },
                "openApiOperationId": { "type": "string" },
                "contractVerified": { "type": "boolean" }
              }
            }
          },
          "dependents": { "type": "array", "items": { "type": "string" } },
          "lastContentHash": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["filePath", "templatePath", "specPath", "specStatus", "detectedFeatures"],
        "properties": {
          "filePath": { "type": "string" },
          "templatePath": { "type": "string" },
          "specPath": { "type": "string" },
          "selector": { "type": "string" },
          "specStatus": {
            "type": "string",
            "enum": ["MISSING", "SHALLOW_STUB", "TRIAGED", "VERIFIED"]
          },
          "detectedFeatures": {
            "type": "object",
            "properties": {
              "inputs": { "type": "array", "items": { "type": "string" } },
              "outputs": { "type": "array", "items": { "type": "string" } },
              "templateBranches": { "type": "integer" },
              "interactiveEvents": { "type": "array", "items": { "type": "string" } },
              "reactiveForms": { "type": "array", "items": { "type": "string" } },
              "i18nKeys": { "type": "array", "items": { "type": "string" } },
              "rbacDirectives": { "type": "array", "items": { "type": "string" } },
              "rxJsSubscriptions": { "type": "integer" }
            }
          },
          "dimensionsVerified": {
            "type": "object",
            "properties": {
              "functionalAndEdgeCases": { "type": "boolean" },
              "errorAndDegradedStates": { "type": "boolean" },
              "rbac": { "type": "boolean" },
              "a11y": { "type": "boolean" },
              "i18n": { "type": "boolean" },
              "memoryLeakUnsubscribe": { "type": "boolean" }
            }
          },
          "ambiguitiesOrSuspectedBugs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "resolution": { "type": "string", "enum": ["OPEN", "CONFIRMED_BUG", "INTENTIONAL_BEHAVIOR"] }
              }
            }
          },
          "lastContentHash": { "type": "string" }
        }
      }
    },
    "featureSlices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["routePath", "components", "services", "e2eSpecPath", "manualChapterId", "status"],
        "properties": {
          "routePath": { "type": "string" },
          "allowedRoles": { "type": "array", "items": { "type": "string" } },
          "components": { "type": "array", "items": { "type": "string" } },
          "services": { "type": "array", "items": { "type": "string" } },
          "mockFixtures": { "type": "array", "items": { "type": "string" } },
          "e2eSpecPath": { "type": "string" },
          "manualChapterId": { "type": "string" },
          "manualOutputPaths": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["PENDING", "TRIAGED", "VERIFIED", "DOCUMENTED"]
          },
          "dimensionsVerified": {
            "type": "object",
            "properties": {
              "happyPathJourney": { "type": "boolean" },
              "errorResilience4xx5xx": { "type": "boolean" },
              "rbacAccessMatrix": { "type": "boolean" },
              "responsiveViewports": { "type": "boolean" },
              "openApiContractSync": { "type": "boolean" },
              "axeAccessibility": { "type": "boolean" },
              "i18nLocales": { "type": "boolean" },
              "performanceWebVitals": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
